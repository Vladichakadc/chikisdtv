# Puerto del backend (en Railway lo asigna la plataforma automaticamente via $PORT)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Secreto para firmar los JWT - cadena larga y aleatoria, distinta por entorno
JWT_SECRET=

# Ruta del archivo SQLite. En Railway: ruta dentro del volumen persistente, ej. /data/database.sqlite
DATABASE_PATH=./database.sqlite

# Carpeta donde se guardan los backups de la base de datos
BACKUP_DIR=./backups

# Clave para cifrar las contraseñas de cuentas padre (AES-256-GCM).
# Usa la MISMA que está en las variables de Railway para poder leer una copia
# de la base de datos de producción. Si se pierde o se cambia, las contraseñas
# cifradas no se pueden recuperar. Sin clave se guardan sin cifrar (con aviso).
CREDENCIALES_KEY=
