# Puerto del backend (en Railway lo asigna la plataforma automaticamente via $PORT)
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Secreto para firmar los JWT - cadena larga y aleatoria, distinta por entorno
JWT_SECRET=

# Ruta del archivo SQLite. En Railway: ruta dentro del volumen persistente, ej. /data/database.sqlite
DATABASE_PATH=./database.sqlite

# Carpeta donde se guardan los backups de la base de datos
BACKUP_DIR=./backups
